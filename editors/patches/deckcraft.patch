index 0000000..164bdc9
--- /dev/null
+++ b/apps/deckcraft-web/src/bridge.rs
@@ -0,0 +1,302 @@
+//! The `postMessage` bridge between the host app (UniCore) and this page.
+//!
+//! The bridge is active only when the page URL carries `?host=parent` and the page is framed
+//! by a parent on the same origin. Messages are plain JS objects with a `type` field. Only
+//! messages whose `event.origin` equals ours *and* whose `event.source` is `window.parent` are
+//! accepted; every message is posted to `window.parent` with our own origin.
+//!
+//! To the parent:
+//! - `uc:ready` `{ version }` — once the app can receive files.
+//! - `uc:failed` `{ error }` — when the app could not start.
+//! - `uc:save` `{ name, bytes, saveAs }` — for every file the app would otherwise download or
+//!   write (Save, Save As, Export). `bytes` is a transferred `ArrayBuffer`. `saveAs` is false for
+//!   a save of the native editable format (`.deckcraft`) and true for exports and other formats.
+//! - `uc:dirty` `{ dirty }` — when unsaved changes appear or disappear (sent only on change).
+//! - `uc:result` `{ id, ok, result? | error? }` — the reply to a `uc:command`.
+//!
+//! From the parent:
+//! - `uc:open` `{ name, bytes }` — open that file exactly like File ▸ Open or a drop would.
+//! - `uc:command` `{ id, command, params }` — run one command on the active document with the
+//!   normal undo support. The bridge answers `uc.commands` (the command catalog) and `uc.read`
+//!   (a plain-text/Markdown rendering of the active document) itself.
+//!
+//! Commands must run with mutable access to the app, which the JS callback cannot take, so they
+//! are queued here and drained at the start of the next frame (a repaint is requested when one
+//! arrives).
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use deckcraft_ui_egui::{Inbox, InboxEvent, InboxFile, SlideApp};
+use serde_json::{Value, json};
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+/// The URL query flag that turns the bridge on.
+const HOST_FLAG: &str = "host=parent";
+/// `uc.read` returns at most this many characters.
+const MAX_READ_CHARS: usize = 60_000;
+/// The editable document formats the host keeps: a save of one clears the dirty flag.
+const NATIVE_EXTS: &[&str] = &[".deckcraft", ".pptx"];
+
+/// A message the parent sent, parsed and waiting for the next frame.
+pub enum Incoming {
+    Open { name: String, bytes: Vec<u8> },
+    Command { id: Value, command: String, params: Value },
+}
+
+/// The live bridge: the inbound queue shared with the JS listener and the frame state.
+pub struct Bridge {
+    queue: Rc<RefCell<Vec<Incoming>>>,
+    native_saved: Rc<Cell<bool>>,
+    /// Kept alive so the `message` listener stays installed for the page's lifetime.
+    _listener: Closure<dyn FnMut(web_sys::MessageEvent)>,
+    ready_sent: bool,
+    last_dirty: Option<bool>,
+}
+
+/// True when `?host=parent` is set and the page is framed by a same-origin parent.
+pub fn host_requested() -> bool {
+    let Some(window) = web_sys::window() else { return false };
+    if !window.location().search().unwrap_or_default().contains(HOST_FLAG) {
+        return false;
+    }
+    let Ok(Some(parent)) = window.parent() else { return false };
+    // Not framed (a top-level page is its own parent): no host.
+    let window_js: JsValue = window.clone().into();
+    let parent_js: JsValue = parent.clone().into();
+    if js_sys::Object::is(&parent_js, &window_js) {
+        return false;
+    }
+    // Same origin: reading the parent's origin fails (or differs) for a cross-origin parent.
+    let ours = window.location().origin().ok();
+    let theirs = parent.location().origin().ok();
+    ours.is_some() && ours == theirs
+}
+
+impl Bridge {
+    /// Installs the `message` listener and returns the bridge. `ctx` is repainted when a message
+    /// arrives so the queued command runs on the next frame.
+    pub fn install(queue: Rc<RefCell<Vec<Incoming>>>, native_saved: Rc<Cell<bool>>, ctx: egui::Context) -> Option<Bridge> {
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        let parent_js: JsValue = parent.clone().into();
+        let our_origin = window.location().origin().ok()?;
+        let q = queue.clone();
+        let listener = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if event.origin() != our_origin {
+                return;
+            }
+            let source = match event.source() {
+                Some(s) => s,
+                None => return,
+            };
+            let source_js: JsValue = source.into();
+            if !js_sys::Object::is(&source_js, &parent_js) {
+                return;
+            }
+            if let Some(message) = parse_incoming(&event) {
+                q.borrow_mut().push(message);
+                ctx.request_repaint();
+            }
+        });
+        window.add_event_listener_with_callback("message", listener.as_ref().unchecked_ref()).ok()?;
+        Some(Bridge { queue, native_saved, _listener: listener, ready_sent: false, last_dirty: None })
+    }
+
+    /// Runs the messages that arrived since the last frame against the live app.
+    pub fn drain(&mut self, app: &mut SlideApp, inbox: &Inbox) {
+        let messages: Vec<Incoming> = self.queue.borrow_mut().drain(..).collect();
+        for message in messages {
+            match message {
+                Incoming::Open { name, bytes } => {
+                    // Exactly the drop path: capture the target now, apply when the bytes land.
+                    let id = app.begin_external_file("open");
+                    push_inbox(inbox, InboxEvent::File(InboxFile { id, name, bytes }));
+                }
+                Incoming::Command { id, command, params } => {
+                    let result = run_bridge_command(app, &command, params);
+                    post_result(&id, result);
+                }
+            }
+        }
+    }
+
+    /// Sends `uc:ready` once, honours a pending native save, and reports dirty changes.
+    pub fn after_frame(&mut self, app: &mut SlideApp) {
+        if !self.ready_sent {
+            self.ready_sent = true;
+            post_json(&json!({"type": "uc:ready", "version": env!("CARGO_PKG_VERSION")}));
+        }
+        if self.native_saved.get() {
+            self.native_saved.set(false);
+            if let Some(st) = app.session.active_mut() {
+                st.saved_doc = st.doc.clone();
+            }
+        }
+        let dirty = app.session.active().is_some_and(|d| d.is_dirty());
+        match self.last_dirty {
+            Some(previous) if previous != dirty => {
+                self.last_dirty = Some(dirty);
+                post_json(&json!({"type": "uc:dirty", "dirty": dirty}));
+            }
+            None => self.last_dirty = Some(dirty),
+            _ => {}
+        }
+    }
+}
+
+/// Tell the parent the app could not start.
+pub fn post_failed(error: &str) {
+    post_json(&json!({"type": "uc:failed", "error": error}));
+}
+
+/// Send one file to the parent as `uc:save`, transferring its bytes. A save of the native
+/// editable format marks the document saved (`native_saved`), so the dirty flag clears.
+pub fn emit_save(name: &str, bytes: &[u8], native_saved: &Rc<Cell<bool>>) {
+    let lower = name.to_ascii_lowercase();
+    let native = NATIVE_EXTS.iter().any(|ext| lower.ends_with(ext));
+    if native {
+        native_saved.set(true);
+    }
+    let Some(window) = web_sys::window() else { return };
+    let Ok(Some(parent)) = window.parent() else { return };
+    let Ok(origin) = window.location().origin() else { return };
+    let array = js_sys::Uint8Array::from(bytes);
+    let buffer = array.buffer();
+    let object = js_sys::Object::new();
+    set(&object, "type", &JsValue::from_str("uc:save"));
+    set(&object, "name", &JsValue::from_str(name));
+    set(&object, "bytes", buffer.as_ref());
+    set(&object, "saveAs", &JsValue::from_bool(!native));
+    let transfer = js_sys::Array::new();
+    transfer.push(buffer.as_ref());
+    let _ = parent.post_message_with_transfer(object.as_ref(), &origin, transfer.as_ref());
+}
+
+fn run_bridge_command(app: &mut SlideApp, command: &str, params: Value) -> Result<Value, String> {
+    match command {
+        "uc.commands" => Ok(command_catalog(app)),
+        "uc.read" => Ok(read_document(app)),
+        _ => app.run(command, params),
+    }
+}
+
+/// `uc.commands`: every available engine command with its parameter description.
+fn command_catalog(app: &SlideApp) -> Value {
+    let list: Vec<Value> = app
+        .session
+        .commands()
+        .into_iter()
+        .map(|c| {
+            json!({
+                "id": c.id,
+                "label": c.label,
+                "description": c.params,
+                "params": c.params,
+                "menu": c.menu,
+                "shortcut": c.shortcut,
+                "enabled": c.enabled,
+            })
+        })
+        .collect();
+    Value::Array(list)
+}
+
+/// `uc.read`: a readable Markdown rendering of the active document, capped in length. This app
+/// holds presentations only, so it renders per slide: a `## Slide N` heading, the slide's texts
+/// and its notes.
+fn read_document(app: &SlideApp) -> Value {
+    let Some(st) = app.session.active() else {
+        return json!({"name": "", "text": ""});
+    };
+    let name = st.path.clone().unwrap_or_else(|| st.title());
+    let doc = st.doc.clone();
+    let mut text = String::new();
+    for (i, slide) in doc.slides.iter().enumerate() {
+        text.push_str("## Slide ");
+        text.push_str(&(i + 1).to_string());
+        text.push('\n');
+        let title = slide.title();
+        if !title.trim().is_empty() {
+            text.push_str(title.trim());
+            text.push('\n');
+        }
+        for shape in &slide.shapes {
+            if let Some(body) = &shape.text {
+                let body = body.text();
+                let body = body.trim();
+                if !body.is_empty() {
+                    text.push_str(body);
+                    text.push('\n');
+                }
+            }
+        }
+        let notes = slide.notes_text();
+        let notes = notes.trim();
+        if !notes.is_empty() {
+            text.push_str("Notes: ");
+            text.push_str(notes);
+            text.push('\n');
+        }
+        text.push('\n');
+        if text.chars().count() > MAX_READ_CHARS {
+            text = text.chars().take(MAX_READ_CHARS).collect();
+            break;
+        }
+    }
+    json!({"name": name, "text": text})
+}
+
+fn parse_incoming(event: &web_sys::MessageEvent) -> Option<Incoming> {
+    let data = event.data();
+    let ty = js_sys::Reflect::get(&data, &JsValue::from_str("type")).ok()?.as_string()?;
+    match ty.as_str() {
+        "uc:open" => {
+            let name = js_sys::Reflect::get(&data, &JsValue::from_str("name")).ok()?.as_string()?;
+            let bytes = match js_sys::Reflect::get(&data, &JsValue::from_str("bytes")) {
+                Ok(v) if v.is_undefined() || v.is_null() => Vec::new(),
+                Ok(v) => js_sys::Uint8Array::new(&v).to_vec(),
+                Err(_) => Vec::new(),
+            };
+            Some(Incoming::Open { name, bytes })
+        }
+        "uc:command" => {
+            let command = js_sys::Reflect::get(&data, &JsValue::from_str("command")).ok()?.as_string()?;
+            let id = js_sys::Reflect::get(&data, &JsValue::from_str("id")).map(|v| js_to_json(&v)).unwrap_or(Value::Null);
+            let params = js_sys::Reflect::get(&data, &JsValue::from_str("params")).map(|v| js_to_json(&v)).unwrap_or(Value::Null);
+            Some(Incoming::Command { id, command, params })
+        }
+        _ => None,
+    }
+}
+
+fn js_to_json(value: &JsValue) -> Value {
+    js_sys::JSON::stringify(value).ok().and_then(|s| s.as_string()).and_then(|s| serde_json::from_str(&s).ok()).unwrap_or(Value::Null)
+}
+
+fn post_result(id: &Value, result: Result<Value, String>) {
+    let message = match result {
+        Ok(value) => json!({"type": "uc:result", "id": id, "ok": true, "result": value}),
+        Err(error) => json!({"type": "uc:result", "id": id, "ok": false, "error": error}),
+    };
+    post_json(&message);
+}
+
+fn post_json(value: &Value) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(Some(parent)) = window.parent() else { return };
+    let Ok(origin) = window.location().origin() else { return };
+    let Ok(text) = serde_json::to_string(value) else { return };
+    let Ok(js) = js_sys::JSON::parse(&text) else { return };
+    let _ = parent.post_message(&js, &origin);
+}
+
+fn set(object: &js_sys::Object, key: &str, value: &JsValue) {
+    let _ = js_sys::Reflect::set(object.as_ref(), &JsValue::from_str(key), value);
+}
+
+fn push_inbox(inbox: &Inbox, event: InboxEvent) {
+    inbox.lock().unwrap_or_else(|e| e.into_inner()).push(event);
+}
