+
+/// A `serde_json::Value` as a JS value, via `JSON.parse` of its serialization.
+fn json_to_js(value: &Json) -> JsValue {
+    match serde_json::to_string(value) {
+        Ok(text) => js_sys::JSON::parse(&text).unwrap_or(JsValue::NULL),
+        Err(_) => JsValue::NULL,
+    }
+}
