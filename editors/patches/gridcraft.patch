+/// `uc.commands`: every engine command with its id, label, ribbon path (as `description`) and
+/// parameter description, as plain JSON.
+fn commands(app: &SheetApp) -> Json {
+    Json::Array(
+        app.session
+            .commands()
+            .iter()
+            .map(|c| {
+                let description = if c.menu.is_empty() { c.label.to_string() } else { c.menu.join(" › ") };
+                json!({"id": c.id, "label": c.label, "description": description, "params": c.params})
+            })
+            .collect(),
+    )
+}
+
+/// `uc.read`: the active workbook as Markdown — each sheet's used range as a table labelled with
+/// its top-left cell — capped at [`MAX_READ_CHARS`].
+fn read(app: &SheetApp) -> Json {
+    let Some(doc) = app.session.active() else { return json!({"name": "", "text": ""}) };
+    let mut out = String::new();
+    for sh in &doc.wb.sheets {
+        let Some(r) = sh.used_range() else { continue };
+        out.push_str(&format!("\n## {} ({})\n\n", sh.name, r.start.a1()));
+        for row in r.start.row..=r.end.row {
+            out.push('|');
+            for col in r.start.col..=r.end.col {
+                out.push(' ');
+                push_cell(&mut out, &gridcraft_engine::display::cell_text(&doc.wb, sh, gridcraft_engine::cell(row, col)));
+                out.push_str(" |");
+            }
+            out.push('\n');
+            if row == r.start.row {
+                out.push('|');
+                for _ in r.start.col..=r.end.col {
+                    out.push_str(" --- |");
+                }
+                out.push('\n');
+            }
+        }
+    }
+    if out.is_empty() {
+        out.push_str("(empty workbook)\n");
+    }
+    truncate(&mut out, MAX_READ_CHARS);
+    json!({"name": doc.display_title(), "text": out})
+}
+
+/// A cell's text as one Markdown table cell: pipes escaped and line breaks flattened.
+fn push_cell(out: &mut String, text: &str) {
+    for c in text.chars() {
+        match c {
+            '|' => out.push_str("\\|"),
+            '\r' | '\n' => out.push(' '),
+            c => out.push(c),
+        }
+    }
+}
+
+/// Cut `text` to at most `max` characters, on a character boundary, without splitting a surrogate.
+fn truncate(text: &mut String, max: usize) {
+    if text.chars().count() <= max {
+        return;
+    }
+    let end = text.char_indices().nth(max).map(|(i, _)| i).unwrap_or(text.len());
+    text.truncate(end);
+    text.push('…');
+}
