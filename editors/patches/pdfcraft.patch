+
+impl PdfCraftApp {
+    /// Drain and run the commands the embedding page queued since the last frame (web bridge,
+    /// `uc:command`), answering each as `uc:result`.
+    fn run_host_commands(&mut self) {
+        let Some(queue) = self.host_commands.clone() else { return };
+        let queued: Vec<crate::HostCommand> = queue.borrow_mut().drain(..).collect();
+        for cmd in queued {
+            let result = self.run_host_command(&cmd);
+            if let Some(reply) = self.host_reply.clone() {
+                reply(&cmd.id, result);
+            }
+        }
+    }
+
+    /// One host command: the two built-ins (`uc.commands`, `uc.read`), else a registry command.
+    fn run_host_command(&mut self, cmd: &crate::HostCommand) -> Result<serde_json::Value, String> {
+        match cmd.command.as_str() {
+            "uc.commands" => Ok(host_command_catalog()),
+            "uc.read" => self.host_read(),
+            id => match pdfcraft_engine::commands::command(id) {
+                None => Err(format!("unknown command: {id}")),
+                Some(_) if self.execute(id) => Ok(serde_json::Value::Null),
+                Some(_) => Err(format!("command not available now: {id}")),
+            },
+        }
+    }
+
+    /// The text of the active document, for the host (`uc.read`).
+    fn host_read(&mut self) -> Result<serde_json::Value, String> {
+        let (_, id) = self.active_ids().ok_or_else(|| "no document is open".to_string())?;
+        let doc = self.session.get(id).ok_or_else(|| "no document is open".to_string())?;
+        let name = doc.name.clone();
+        let pages: Vec<usize> = (0..doc.info.pages.len()).collect();
+        let source = doc.export_source();
+        let mut exporter = pdfcraft_engine::export::Exporter::from_source(source);
+        let text = exporter.text_of(&pages)?;
+        let text: String = text.chars().take(60_000).collect();
+        Ok(serde_json::json!({ "name": name, "text": text }))
+    }
+}
+
+/// The registry as the embedding page's `uc.commands` sees it. The engine registry carries no
+/// description or parameter schema, so both are `null`.
+fn host_command_catalog() -> serde_json::Value {
+    let list: Vec<serde_json::Value> = pdfcraft_engine::commands::COMMANDS
+        .iter()
+        .map(|c| {
+            serde_json::json!({
+                "id": c.id,
+                "label": c.label,
+                "description": serde_json::Value::Null,
+                "params": serde_json::Value::Null,
+            })
+        })
+        .collect();
+    serde_json::Value::Array(list)
+}
