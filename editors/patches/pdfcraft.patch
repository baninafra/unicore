+
+/// A command the embedding page asked UniCore to run (web bridge, `uc:command`). The `id` is the
+/// host's opaque token, echoed in the reply as `uc:result`.
+#[derive(Clone, Debug)]
+pub struct HostCommand {
+    pub id: String,
+    pub command: String,
+    #[allow(dead_code)]
+    pub params: serde_json::Value,
+}
+
+/// Commands the embedding page queued on the wasm event loop, drained at the start of the next
+/// frame so they run with the app's full mutable state (web bridge, `uc:command`).
+pub type HostCommandQueue = std::rc::Rc<std::cell::RefCell<Vec<HostCommand>>>;
+
+/// Replies to one host command as `uc:result`: `Ok(value)` or `Err(message)` (web bridge).
+pub type HostReplyFn = std::rc::Rc<dyn Fn(&str, Result<serde_json::Value, String>)>;
