-            "JavaScript",
-            "Microsoft Word (.docx)",
-            "PDF/A…",
-            "PostScript / EPS",
-            "Rich Text Format (.rtf)",
-            "CheckBox",
-            "Combo",
-            "Home / End",
-            "PushButton",
-            "Radio",
-            "Standard Business",
-            "Keychain  ·  ",
-            "{0}: {1}",
-            "{field}: {e}",
-            "{month} {y}",
-            "{n} {kind}",
-            "{rule} - {status}",
-            "+LOC",
-            "−LOC",
-            "ΔLOC",
-            "+Bin",
-            "−Bin",
-            "`{command}` {when}",
-            "English",
