+/// The `postMessage` bridge to a same-origin parent page (`?host=parent`). Messages are plain
+/// objects with a `type`:
+///
+/// - `uc:ready` (to the parent): `{ version }`, the app is listening; send files now.
+/// - `uc:failed` (to the parent): `{ error }` when the app couldn't start.
+/// - `uc:open` (from the parent): `{ name, bytes }`, where `bytes` is an `ArrayBuffer` or
+///   `Uint8Array` holding a PDF. It opens in a tab, like a `?file=` URL.
+/// - `uc:save` (to the parent): `{ name, saveAs, bytes }` for every file the app would otherwise
+///   download (Save, Save As, exports); `bytes` is a transferred `ArrayBuffer`.
+/// - `uc:dirty` (to the parent): `{ dirty }` whenever unsaved work appears or goes away.
+/// - `uc:command` (from the parent): `{ id, command, params }`, one registry command (or the
+///   built-ins `uc.commands` and `uc.read`), run at the start of the next frame.
+/// - `uc:result` (to the parent): `{ id, ok, result }` or `{ id, ok: false, error }`.
+///
+/// Only the parent window on the app's own origin is heard or answered.
+#[cfg(target_arch = "wasm32")]
+mod host {
+    use eframe::wasm_bindgen::{JsCast, JsValue, closure::Closure};
+
+    type SaveRc = std::rc::Rc<dyn Fn(&str, &[u8], bool) -> Result<(), String>>;
+
+    #[derive(Clone)]
+    pub struct Bridge {
+        window: web_sys::Window,
+        parent: web_sys::Window,
+        origin: String,
+    }
+
+    impl Bridge {
+        /// `None` when the page isn't framed (there is no parent to talk to).
+        pub fn new() -> Option<Self> {
+            let window = web_sys::window()?;
+            let parent = window.parent().ok().flatten()?;
+            if js_sys::Object::is(&parent, &window) {
+                return None;
+            }
+            let origin = window.location().origin().ok()?;
+            Some(Self { window, parent, origin })
+        }
+
+        fn post(&self, message: &js_sys::Object, transfer: Option<&JsValue>) -> Result<(), String> {
+            let sent = match transfer {
+                Some(t) => self.parent.post_message_with_transfer(message, &self.origin, &js_sys::Array::of1(t)),
+                None => self.parent.post_message(message, &self.origin),
+            };
+            sent.map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))
+        }
+
+        pub fn post_ready(&self) {
+            if let Some(m) = message(&[("type", "uc:ready".into()), ("version", env!("CARGO_PKG_VERSION").into())]) {
+                let _ = self.post(&m, None);
+            }
+        }
+
+        /// The app couldn't start (no WebGL, for example): let the parent say so.
+        pub fn post_failed(&self, error: &str) {
+            if let Some(m) = message(&[("type", "uc:failed".into()), ("error", error.into())]) {
+                let _ = self.post(&m, None);
+            }
+        }
+
+        /// Hear `uc:open` (queued like a `?file=` download) and `uc:command` (queued for the
+        /// next frame) from the parent.
+        pub fn listen(&self, inbox: pdfcraft_ui_egui::Inbox, commands: pdfcraft_ui_egui::HostCommandQueue, ctx: egui::Context) {
+            let parent = self.parent.clone();
+            let origin = self.origin.clone();
+            let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+                if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                    return;
+                }
+                let data = event.data();
+                match string(&data, "type").as_deref() {
+                    Some("uc:open") => {
+                        let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "document.pdf".to_string());
+                        let Ok(bytes) = js_sys::Reflect::get(&data, &JsValue::from_str("bytes")) else { return };
+                        let bytes = if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+                            array.to_vec()
+                        } else if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+                            js_sys::Uint8Array::new(&bytes).to_vec()
+                        } else {
+                            return;
+                        };
+                        if let Ok(mut q) = inbox.lock() {
+                            q.push((name, bytes));
+                        }
+                    }
+                    Some("uc:command") => {
+                        let Some(command) = string(&data, "command") else { return };
+                        let id = js_sys::Reflect::get(&data, &JsValue::from_str("id"))
+                            .ok()
+                            .and_then(|v| v.as_string().or_else(|| v.as_f64().map(|n| n.to_string())))
+                            .unwrap_or_default();
+                        let params = js_sys::Reflect::get(&data, &JsValue::from_str("params"))
+                            .ok()
+                            .and_then(|v| js_sys::JSON::stringify(&v).ok())
+                            .and_then(|s| s.as_string())
+                            .and_then(|s| serde_json::from_str(&s).ok())
+                            .unwrap_or(serde_json::Value::Null);
+                        commands.borrow_mut().push(pdfcraft_ui_egui::HostCommand { id, command, params });
+                    }
+                    _ => return,
+                }
+                ctx.request_repaint();
+            });
+            if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+                // The listener lives as long as the page.
+                on_message.forget();
+            }
+        }
+
+        /// Hands a file to the parent as `uc:save`.
+        pub fn save_rc(&self) -> SaveRc {
+            let bridge = self.clone();
+            std::rc::Rc::new(move |name: &str, bytes: &[u8], save_as: bool| {
+                let buffer = js_sys::Uint8Array::from(bytes).buffer();
+                let m = message(&[("type", "uc:save".into()), ("name", name.into()), ("saveAs", save_as.into()), ("bytes", buffer.clone().into())])
+                    .ok_or_else(|| "couldn't build the message".to_string())?;
+                bridge.post(&m, Some(&buffer))
+            })
+        }
+
+        pub fn dirty_fn(&self) -> pdfcraft_ui_egui::HostDirtyFn {
+            let bridge = self.clone();
+            let mut last = false;
+            Box::new(move |dirty: bool| {
+                if dirty != last {
+                    last = dirty;
+                    if let Some(m) = message(&[("type", "uc:dirty".into()), ("dirty", dirty.into())]) {
+                        let _ = bridge.post(&m, None);
+                    }
+                }
+            })
+        }
+
+        /// Answers one `uc:command` as `uc:result`.
+        pub fn reply_fn(&self) -> pdfcraft_ui_egui::HostReplyFn {
+            let bridge = self.clone();
+            std::rc::Rc::new(move |id: &str, result: Result<serde_json::Value, String>| {
+                let fields: Vec<(&str, JsValue)> = match result {
+                    Ok(value) => {
+                        let value = serde_json::to_string(&value).ok().and_then(|s| js_sys::JSON::parse(&s).ok()).unwrap_or(JsValue::NULL);
+                        vec![("type", "uc:result".into()), ("id", id.into()), ("ok", true.into()), ("result", value)]
+                    }
+                    Err(error) => vec![("type", "uc:result".into()), ("id", id.into()), ("ok", false.into()), ("error", error.as_str().into())],
+                };
+                if let Some(m) = message(&fields) {
+                    let _ = bridge.post(&m, None);
+                }
+            })
+        }
+    }
+
+    fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+        let m = js_sys::Object::new();
+        for (key, value) in fields {
+            js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+        }
+        Some(m)
+    }
+
+    fn string(data: &JsValue, key: &str) -> Option<String> {
+        js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn main() {
+    eprintln!("pdfcraft-web targets wasm32: run `trunk serve` or `trunk build --release` in apps/pdfcraft-web");
+}
