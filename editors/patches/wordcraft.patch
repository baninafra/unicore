diff --git a/apps/wordcraft-web/src/bridge.rs b/apps/wordcraft-web/src/bridge.rs
new file mode 100644
index 00000000..7826cd3e
--- /dev/null
+++ b/apps/wordcraft-web/src/bridge.rs
@@ -0,0 +1,235 @@
+//! The UniCore command channel: `uc:command` / `uc:result` between this app and the host page
+//! that embeds it in an `<iframe>`. Files, `uc:ready`, `uc:save` and `uc:dirty` live in `host`.
+//!
+//! The bridge is **only** active when the page URL has `?host=parent` **and** the page is framed
+//! by a parent window on the same origin. It only accepts messages whose `event.origin` equals
+//! our own origin and whose `event.source` is `window.parent`, and it only posts to
+//! `window.parent` with our own origin as the target. No message crosses an origin boundary.
+//!
+//! ## Messages to the parent
+//!
+//! - `uc:ready` `{ version }` — once, as soon as the app can receive files.
+//! - `uc:failed` `{ error }` — if the app couldn't start.
+//! - `uc:save` `{ name, bytes, saveAs }` — for **every** file the app would otherwise download
+//!   or write: Save, Save As and every export (PDF, images, other formats). `bytes` is a
+//!   transferred `ArrayBuffer`; `saveAs` is true for Save As and exports and false for a plain
+//!   Save onto the document's own file. After a Save of the native editable format the document
+//!   counts as saved (it is no longer dirty).
+//! - `uc:dirty` `{ dirty }` — whenever unsaved changes appear or disappear (only on change).
+//! - `uc:result` `{ id, ok: true, result }` or `{ id, ok: false, error }` — the answer to one
+//!   `uc:command`, correlated by its `id`. `result` is the command's JSON return value.
+//!
+//! ## Messages from the parent
+//!
+//! - `uc:open` `{ name, bytes }` (`bytes` = `ArrayBuffer` or `Uint8Array`) — open that file
+//!   exactly as File › Open or a drag-and-drop would. In host mode the app starts with an empty
+//!   document.
+//! - `uc:command` `{ id, command, params }` — run one command (the same ids the ribbon, menus,
+//!   CLI and MCP use) on the active document, with the normal undo support. Replies with
+//!   `uc:result`. Two commands are handled by the bridge itself:
+//!   - `uc.commands` → `result` is an array of `{ id, label, description, params }` for every
+//!     command in the engine's catalog (`description` is the ribbon/menu location, `params` is
+//!     the parameter schema where it parses as JSON, else the raw description string).
+//!   - `uc.read` → `result` is `{ name, text }`: a Markdown rendering of the active document,
+//!     at most [`MAX_READ_CHARS`] characters.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use serde_json::{Value, json};
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::prelude::*;
+
+use wordcraft_ui_egui::WordApp;
+
+/// Most characters `uc.read` returns (a host can page with commands for the rest).
+pub const MAX_READ_CHARS: usize = 60_000;
+
+/// A command the host asked for, queued until the next frame so it can run with `&mut WordApp`.
+pub struct Request {
+    /// The host's correlation id, echoed in `uc:result`.
+    pub id: JsValue,
+    /// The command id (`uc.commands` and `uc.read` are handled by the bridge itself).
+    pub command: String,
+    /// The command's parameters.
+    pub params: Value,
+}
+
+/// One page's bridge: the queue of incoming commands and whether host mode is active.
+#[derive(Clone)]
+pub struct Bridge {
+    requests: Rc<RefCell<Vec<Request>>>,
+    enabled: Rc<Cell<bool>>,
+}
+
+impl Bridge {
+    /// `enabled` says whether this page runs in host mode (`?host=parent` inside a same-origin
+    /// frame); when it is off every sending and receiving path is a no-op.
+    pub fn new(enabled: bool) -> Self {
+        Bridge {
+            requests: Rc::new(RefCell::new(Vec::new())),
+            enabled: Rc::new(Cell::new(enabled)),
+        }
+    }
+
+    /// Whether this page runs in host mode.
+    pub fn enabled(&self) -> bool {
+        self.enabled.get()
+    }
+
+    /// Install the `message` listener: same-origin messages from `window.parent` only. Valid
+    /// `uc:open` files go straight into `inbox`; `uc:command`s are queued and a repaint follows.
+    pub fn install(&self, ctx: egui::Context) -> Result<(), String> {
+        let window = web_sys::window().ok_or("no window")?;
+        let requests = self.requests.clone();
+        let enabled = self.enabled.clone();
+        let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |e: web_sys::MessageEvent| {
+            if !enabled.get() {
+                return;
+            }
+            let Some(window) = web_sys::window() else { return };
+            let Ok(our_origin) = window.location().origin() else { return };
+            if e.origin() != our_origin {
+                return;
+            }
+            let Ok(Some(parent)) = window.parent() else { return };
+            let Some(source) = e.source() else { return };
+            if !js_sys::Object::is(&JsValue::from(source), &JsValue::from(parent)) {
+                return;
+            }
+            let data = e.data();
+            let Some(kind) = get(&data, "type").and_then(|v| v.as_string()) else { return };
+            match kind.as_str() {
+                "uc:command" => {
+                    let Some(command) = get(&data, "command").and_then(|v| v.as_string()) else { return };
+                    let id = get(&data, "id").unwrap_or(JsValue::NULL);
+                    let params = get(&data, "params").map_or_else(|| json!({}), |v| js_to_json(&v));
+                    requests.borrow_mut().push(Request { id, command, params });
+                }
+                _ => {}
+            }
+            ctx.request_repaint();
+        });
+        window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).map_err(|e| format!("{e:?}"))?;
+        // The listener lives as long as the page.
+        on_message.forget();
+        Ok(())
+    }
+
+    /// The queue to drain at the start of a frame.
+    pub fn take_requests(&self) -> Vec<Request> {
+        std::mem::take(&mut *self.requests.borrow_mut())
+    }
+
+    /// Run one queued command and answer the host. The two bridge commands are handled here; any
+    /// other goes through the app's normal command path (`WordApp::execute`).
+    pub fn run(&self, app: &mut WordApp, req: Request) {
+        match req.command.as_str() {
+            "uc.commands" => {
+                let commands: Vec<Value> = app
+                    .session
+                    .registry
+                    .all()
+                    .iter()
+                    .map(|c| {
+                        let params = serde_json::from_str::<Value>(c.params).unwrap_or_else(|_| Value::String(c.params.to_string()));
+                        json!({"id": c.id, "label": c.label, "description": c.location, "params": params})
+                    })
+                    .collect();
+                reply_ok_json(&req.id, &Value::Array(commands));
+            }
+            "uc.read" => {
+                let name = app.title_stem();
+                let text = read_text(app);
+                reply_ok_json(&req.id, &json!({"name": name, "text": text}));
+            }
+            _ => match app.execute(&req.command, req.params) {
+                Ok(v) => reply_ok_json(&req.id, &v),
+                Err(e) => reply_err(&req.id, &e),
+            },
+        }
+    }
+}
+
+fn read_text(app: &WordApp) -> String {
+    let bytes = wordcraft_engine::io::save_bytes("document.md", &app.session.doc).unwrap_or_default();
+    truncate(String::from_utf8_lossy(&bytes).into_owned(), MAX_READ_CHARS)
+}
+
+fn truncate(s: String, max: usize) -> String {
+    if s.chars().count() <= max {
+        s
+    } else {
+        s.chars().take(max).collect()
+    }
+}
+
+/// A plain message object with its `type` set.
+fn message(type_name: &str) -> js_sys::Object {
+    let o = js_sys::Object::new();
+    set(&o, "type", &JsValue::from_str(type_name));
+    o
+}
+
+fn set(o: &js_sys::Object, key: &str, value: &JsValue) {
+    let _ = js_sys::Reflect::set(o, &JsValue::from_str(key), value);
+}
+
+fn get(v: &JsValue, key: &str) -> Option<JsValue> {
+    js_sys::Reflect::get(v, &JsValue::from_str(key)).ok()
+}
+
+/// A JS value as JSON: objects and arrays convert through `JSON.stringify`; anything else is `{}`.
+fn js_to_json(v: &JsValue) -> Value {
+    if !v.is_object() && !v.is_array() {
+        return json!({});
+    }
+    js_sys::JSON::stringify(v)
+        .ok()
+        .and_then(|s| s.as_string())
+        .and_then(|s| serde_json::from_str(&s).ok())
+        .unwrap_or_else(|| json!({}))
+}
+
+/// JSON as a JS value: `JSON.parse` of the serialised value, or `null` when it doesn't round-trip.
+fn json_to_js(v: &Value) -> JsValue {
+    serde_json::to_string(v).ok().and_then(|s| js_sys::JSON::parse(&s).ok()).unwrap_or(JsValue::NULL)
+}
+
+fn reply_ok_json(id: &JsValue, result: &Value) {
+    let msg = message("uc:result");
+    set(&msg, "id", id);
+    set(&msg, "ok", &JsValue::TRUE);
+    set(&msg, "result", &json_to_js(result));
+    post(msg.into());
+}
+
+fn reply_err(id: &JsValue, error: &str) {
+    let msg = message("uc:result");
+    set(&msg, "id", id);
+    set(&msg, "ok", &JsValue::FALSE);
+    set(&msg, "error", &JsValue::from_str(error));
+    post(msg.into());
+}
+
+/// Post to `window.parent` with our own origin, or nothing when we aren't framed.
+fn post(value: JsValue) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(origin) = window.location().origin() else { return };
+    let Ok(Some(parent)) = window.parent() else { return };
+    if js_sys::Object::is(&JsValue::from(parent.clone()), &JsValue::from(window.clone())) {
+        return;
+    }
+    let _ = parent.post_message(&value, &origin);
+}
+
+/// [`post`] with `transfer`'s buffers moved across (used for `uc:save`'s bytes).
+fn post_with_transfer(value: JsValue, transfer: JsValue) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(origin) = window.location().origin() else { return };
+    let Ok(Some(parent)) = window.parent() else { return };
+    if js_sys::Object::is(&JsValue::from(parent.clone()), &JsValue::from(window.clone())) {
+        return;
+    }
+    let _ = parent.post_message_with_transfer(&value, &origin, &transfer);
+}
