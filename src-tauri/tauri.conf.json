{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniCore",
  "version": "0.3.8",
  "identifier": "ar.unicore.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "UniCore",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#16161a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Tus carreras, en un solo núcleo",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxREM0REM2NzQxOTY1RDIKUldUU1pSbDB4azNja1h5bzliNjFRckREaldBcWtTM3dhck1aWG92Z3gvRjFPYlp1SE5aY1lKZFYK",
      "endpoints": [
        "https://github.com/baninafra/unicore/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
